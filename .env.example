POSTGRES_DB=trustvault
POSTGRES_USER=trustvault_app
POSTGRES_PASSWORD=replace_with_a_local_secret
DB_URL=jdbc:postgresql://localhost:5432/trustvault
DB_USERNAME=trustvault_app
DB_PASSWORD=replace_with_a_local_secret
# Optional for a deployment using separate database roles. Uncomment and set
# all three values to a migration-owner connection; otherwise Flyway uses DB_*.
# FLYWAY_URL=jdbc:postgresql://your-db-host:5432/trustvault
# FLYWAY_USERNAME=trustvault_migrator
# FLYWAY_PASSWORD=replace_with_a_separate_migration_secret
TRUSTVAULT_BOOTSTRAP_ADMIN_EMAIL=
TRUSTVAULT_BOOTSTRAP_ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=false
# Public server deployment only; point DNS for this domain to the server IP.
# TRUSTVAULT_DOMAIN=trustvault.example.com
