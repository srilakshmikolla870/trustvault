-- One-time production hardening script. Run with psql as a database administrator
-- after migrations V1 and V2 have completed. Do not run against the local demo DB.
-- This script assumes the existing high-privilege application/bootstrap role is
-- named trustvault_app and the database is named trustvault. Adjust those names
-- for your provider before running it.

CREATE ROLE trustvault_migrator LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
CREATE ROLE trustvault_runtime LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;

-- psql prompts securely; do not put these passwords in this file or command line.
\password trustvault_migrator
\password trustvault_runtime

ALTER DATABASE trustvault OWNER TO trustvault_migrator;
REVOKE CONNECT ON DATABASE trustvault FROM PUBLIC;
GRANT CONNECT ON DATABASE trustvault TO trustvault_migrator, trustvault_runtime;

\connect trustvault

REVOKE CREATE ON SCHEMA public FROM PUBLIC;
ALTER SCHEMA public OWNER TO trustvault_migrator;
GRANT USAGE, CREATE ON SCHEMA public TO trustvault_migrator;
GRANT USAGE ON SCHEMA public TO trustvault_runtime;

DO $$
DECLARE
    object_name record;
BEGIN
    FOR object_name IN
        SELECT tablename FROM pg_tables WHERE schemaname = 'public'
    LOOP
        EXECUTE format('ALTER TABLE public.%I OWNER TO trustvault_migrator', object_name.tablename);
    END LOOP;

    FOR object_name IN
        SELECT sequencename FROM pg_sequences WHERE schemaname = 'public'
    LOOP
        EXECUTE format('ALTER SEQUENCE public.%I OWNER TO trustvault_migrator', object_name.sequencename);
    END LOOP;
END
$$;

ALTER FUNCTION public.reject_audit_event_mutation() OWNER TO trustvault_migrator;

GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA public TO trustvault_runtime;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO trustvault_runtime;
REVOKE ALL ON TABLE public.audit_events FROM trustvault_runtime;
GRANT SELECT, INSERT ON TABLE public.audit_events TO trustvault_runtime;
REVOKE ALL ON TABLE public.flyway_schema_history FROM trustvault_runtime;

-- The API needs INSERT/UPDATE access for account and grant workflows.
-- This makes the API process part of the trusted boundary: a compromised
-- process could issue direct writes. The runtime role cannot own schema objects
-- or rewrite audit rows, but PostgreSQL cannot distinguish service methods
-- using this shared connection identity.
REVOKE TRUNCATE ON ALL TABLES IN SCHEMA public FROM trustvault_runtime;

ALTER DEFAULT PRIVILEGES FOR ROLE trustvault_migrator IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE ON TABLES TO trustvault_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE trustvault_migrator IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO trustvault_runtime;

-- Disable the old bootstrap superuser login only after role setup and grants.
ALTER ROLE trustvault_app NOSUPERUSER NOCREATEDB NOCREATEROLE NOLOGIN;

\echo 'Hardening complete. Configure DB_USERNAME/DB_PASSWORD for trustvault_runtime and FLYWAY_USERNAME/FLYWAY_PASSWORD for trustvault_migrator.'
